{
  "name": "pi-glossary",
  "version": "0.6.0",
  "description": "Pi extension that lazy-loads glossary definitions into the agent context when prompts mention matching terms",
  "author": "Ronie",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruliana/pi-glossary.git"
  },
  "homepage": "https://github.com/ruliana/pi-glossary#readme",
  "bugs": {
    "url": "https://github.com/ruliana/pi-glossary/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "glossary",
    "extension"
  ],
  "scripts": {
    "postinstall": "node scripts/install-default-glossary.js",
    "test": "bun test"
  },
  "files": [
    "index.ts",
    "glossary.json",
    "scripts/",
    "skills/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  }
}
